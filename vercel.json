{
  "rewrites": [
    {
      "source": "/mentions-legales",
      "destination": "/mentions-legales.html"
    },
    {
      "source": "/confidentialite",
      "destination": "/confidentialite.html"
    },
    {
      "source": "/pelouse-parfaite",
      "destination": "/pelouse-parfaite.html"
    },
    {
      "source": "/lignes-tonte",
      "destination": "/lignes-tonte.html"
    },
    {
      "source": "/gazon-jaunit",
      "destination": "/gazon-jaunit.html"
    },
    {
      "source": "/enlever-mousse-pelouse",
      "destination": "/enlever-mousse-pelouse.html"
    },
    {
      "source": "/semer-pelouse-nord",
      "destination": "/semer-pelouse-nord.html"
    },
    {
      "source": "/engrais-pelouse",
      "destination": "/engrais-pelouse.html"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "x-forwarded-proto",
          "value": "http"
        }
      ],
      "destination": "https://toncoachjardin.fr/$1",
      "permanent": true
    }
  ]
}